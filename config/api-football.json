{
  "provider": "api-football",
  "apiVersion": "v3",
  "baseUrl": "https://v3.football.api-sports.io",
  "auth": {
    "header": "x-apisports-key",
    "keyEnv": "API_FOOTBALL_KEY"
  },
  "quota": {
    "plan": "pro",
    "configuredDailyBudget": 7500,
    "configuredPerMinuteLimit": 300,
    "minimumRequestIntervalMs": 300,
    "trustResponseHeadersOverConfiguredLimits": true,
    "reserveForTrackedFixtures": 100,
    "softStopRemaining": 50
  },
  "sync": {
    "timezone": "Asia/Tokyo",
    "neverExposeApiKeyToBrowser": true,
    "serverSideOnly": true,
    "persistProviderIds": true,
    "persistQuotaHeaders": true,
    "schemaMapping": "config/api-football-schema-v2-map.json",
    "scheduledSynchronizationEnabled": false,
    "manualExistingResultsBackfillEnabled": true,
    "manualExistingResultsManifest": "config/api-football-existing-results.json",
    "manualExistingResultsState": "state/api-football-existing-results.json",
    "manualExistingResultsDiscoveryMode": "fixed_manifest_dates",
    "manualExistingResultsNeverPersistsUnlistedOrScheduledFixtures": true,
    "enableOnlyAfterCoverageInventoryAndConsistencyTests": true
  }
}
