{
  "version": 19,
  "updatedAt": "2026-08-21T15:51:00+09:00",
  "scope": {
    "leagues": ["Premier League", "EFL Championship", "Bundesliga", "Belgian Pro League", "Eredivisie", "La Liga", "Ligue 1", "Serie A", "Scottish Premiership", "Primeira Liga"],
    "focus": "Japanese players and their overseas clubs",
    "exclusions": ["J1"],
    "scopeNote": "J1 belongs to the separate analysis app and must not block or participate in japanese-football-watch collection, validation, snapshot, or update decisions. Players who transfer from the tracked scope to J1 or any other non-tracked league remain in the player dataset as out-of-scope records."
  },
  "seasonPolicy": {
    "manifest": "seasons.json",
    "activeSeasonField": "current",
    "resolveActiveDataPathFromManifest": true,
    "activeSeasonDataBundle": {
      "basePath": "resolve seasons.json current entry data",
      "overlayManifestPattern": "data/{season}/backfill/index.json",
      "overlayOrderIsAuthoritative": true,
      "runtimeMerge": true,
      "snapshotPath": "state/latest_snapshot.json"
    },
    "neverOverwritePreviousSeason": true,
    "onSeasonRollover": ["freeze_previous_season_data", "create_new_season_data_path", "append_new_season_to_manifest", "move_manifest_current_to_new_season"]
  },
  "workflow": [
    "resolve_active_season_and_data_bundle",
    "backfill_stored_completed_matches_before_new_targets",
    "fetch_latest_information",
    "finish_all_league_and_club_collection_for_defined_tracking_scope",
    "finish_all_player_level_collection_for_known_matches",
    "apply_player_identity_and_membership_changes",
    "stamp_player_match_records_with_player_id_match_id_club_and_competition",
    "rebuild_player_season_competition_club_and_club_competition_aggregates",
    "finish_jfw_rating_input_collection",
    "build_integrated_snapshot",
    "validate_internal_consistency",
    "update_active_season_data_bundle_only_if_valid",
    "compare_active_season_data_bundle_with_snapshot",
    "validate_site_structure_and_render_contract",
    "finish_only_when_all_checks_pass",
    "report_to_user"
  ],
  "playerIdentityPolicy": {
    "stablePlayerIdRequired": true,
    "playerIdSurvivesClubAndLeagueTransfers": true,
    "clubChangeNeverCreatesNewPlayer": true,
    "nameMatchingFallback": "migration_only",
    "matchRecordsPreferPlayerId": true,
    "membershipHistoryRequired": true,
    "membershipCorrectionsRequiredForHistoricalCorrection": true
  },
  "transferPolicy": {
    "modelVersion": "1.0",
    "documentation": "docs/player-tracking-data-model-v1.0.md",
    "membershipChangeTypes": ["transfer", "loan", "loan_return", "registration", "correction"],
    "confirmedMovementShouldProvideEffectiveDate": true,
    "effectiveDateFields": ["effectiveDate", "transferDate"],
    "keepPreviousClub": true,
    "keepPreviousLeague": true,
    "keepMembershipHistory": true,
    "trackedToTracked": {
      "reusePlayerId": true,
      "continueAutomaticTracking": true,
      "continueSeasonStats": true,
      "splitClubStats": true,
      "preserveCompetitionStats": true,
      "doNotMoveOldClubStatsToNewClub": true
    },
    "trackedToOutOfScope": {
      "retainPlayerRecord": true,
      "retainActualDestinationClubAndLeague": true,
      "trackingStatus": "out_of_scope",
      "uiBucket": "無所属・追跡対象外",
      "rankingEligible": true,
      "freezeTrackedSeasonStatsAtExit": true,
      "doNotCreateTrackedClubForDestination": true,
      "doNotAutomaticallyCollectDestinationMatchStats": true
    },
    "outOfScopeToTracked": {
      "reusePlayerId": true,
      "appendTrackedMembershipPeriod": true,
      "resumeAutomaticTracking": true,
      "resumeSameSeasonAggregateWhenSeasonMatches": true
    },
    "correction": {
      "mustNotCreateFakeTransferStint": true,
      "recordInMembershipCorrections": true
    }
  },
  "backfillPolicy": {
    "priority": "highest",
    "rule": "Every stored completed match involving a tracked Japanese player must have playerMatchStats records for all tracked Japanese players whose lineup/bench/absence state can be verified.",
    "manifestPattern": "data/{season}/backfill/index.json",
    "fragmentedStorage": true,
    "mergeAtLoad": true,
    "neverGuessMissingValues": true,
    "recordMissingFieldsExplicitly": true,
    "retryMissingFieldsBeforeNormalTargets": true,
    "crossCheckAggregatePlayerStats": true,
    "crossCheckGaResults": true,
    "correctStoredMatchResultWhenVerifiedMismatchFound": true,
    "doNotLeaveKnownMatchWithoutVerifiedPlayerDetailWhenPublicDataExists": true
  },
  "playerDataPolicy": {
    "fields": ["appearance", "start", "bench", "minutes", "goals", "assists", "cleanSheets", "yellowCards", "secondYellowRed", "straightRed", "substitution", "shots", "shotsOnTarget", "keyPasses", "tackles", "interceptions", "clearances", "blocks", "saves", "duelsWon", "duelsTotal", "aerialDuelsWon", "aerialDuelsTotal", "dribbles", "dribbledPast", "bigChancesMissed", "possessionsLost", "passesCompleted", "passesAttempted", "shotsOnTargetFaced", "penaltiesSaved", "penaltiesConceded", "ownGoals", "highClaims", "errorsLeadingToGoal", "gaOnPitch"],
    "missingData": {
      "setPriorityUpdate": true,
      "priorityFlagField": "priorityUpdate",
      "priorityFieldsField": "priorityFields",
      "retryBeforeNormalTargets": true,
      "neverGuessMissingValues": true,
      "clearFieldWhenResolved": true,
      "clearPriorityWhenAllResolved": true
    },
    "aggregation": {
      "sourceOfTruth": "playerMatchStats plus verified aggregate baselines with machine-readable cutoff",
      "aggregateCutoffFields": ["aggregateAsOf", "statsAsOfDate"],
      "rebuildAfterEveryMatchOrMembershipMutation": true,
      "seasonStatsField": "seasonStats",
      "competitionStatsField": "competitionStats",
      "clubStatsField": "clubStats",
      "clubCompetitionStatsField": "clubCompetitionStats",
      "storeSeasonStats": true,
      "storeCompetitionStatsSeparately": true,
      "storeClubStatsSeparately": true,
      "storeClubCompetitionStatsSeparately": true,
      "excludeFriendliesAndPreseason": true,
      "onlyAggregateTrackedPeriods": true,
      "neverTreatMissingAggregateInputAsZero": true,
      "mustPropagateVerifiedGoalsAndAssistsToPlayerSummary": true,
      "mustPreserveMatchProvenance": true,
      "matchProvenancePath": "playerId -> playerMatchStats -> matchId -> matches",
      "clubPageMustUseClubStatsNotSeasonStats": true,
      "competitionRankingMustUseCompetitionStatsNotCurrentLeague": true
    }
  },
  "providerIntegrationPolicy": {
    "provider": "api-football",
    "apiVersion": "v3",
    "connectionSmokeTestPassed": true,
    "schemaMapping": "config/api-football-schema-v2-map.json",
    "mappingImplementation": "scripts/api-football/schema-v2-mapper.js",
    "fieldInventoryImplementation": "scripts/api-football/field-inventory.js",
    "scheduledSynchronizationEnabled": false,
    "manualExistingResultBackfill": {
      "enabled": true,
      "targetManifest": "config/api-football-existing-results.json",
      "targetRule": "stored match must already have status verified and a final score",
      "targetCountAtAuthorization": 27,
      "requestLatestFeed": false,
      "requestScheduledFixtures": false,
      "providerPlan": "pro",
      "fixtureDiscovery": "only the nine fixed manifest dates; never latest, next, or last",
      "teamLastDiscoveryMayReadUnlistedCompletedResults": false,
      "persistUnlistedCompletedResults": false,
      "detailEndpoints": ["/fixtures/events", "/fixtures/lineups", "/fixtures/players", "/coachs?team={teamId} only when the fixture lineup omits its coach"],
      "outputFragment": "data/2026-27/backfill/api-football-existing-results.json",
      "resumableState": "state/api-football-existing-results.json",
      "dailyRequestReserve": 100,
      "minimumRequestIntervalMs": 300,
      "persistRawResponses": false
    },
    "enableScheduledSynchronizationOnlyAfter": [
      "tracked_league_team_and_player_provider_ids_are_registered",
      "one_completed_fixture_per_tracked_league_has_field_inventory",
      "goal_event_and_player_statistics_reconciliation_tests_pass",
      "missing_values_remain_missing",
      "quota_soft_stop_and_retry_priority_are_enforced",
      "all_internal_consistency_tests_pass"
    ],
    "matchFactsRemainSourceOfTruth": true,
    "seasonAggregateEndpointIsCrossCheckOnly": true,
    "goalEventMustCreatePlayerMatchRecordWhenPlayerStatisticsAreMissing": true,
    "positiveGoalsAndAssistsMustNeverBeDroppedByEmptyOrIncompleteEventData": true,
    "eventDerivedZeroRequiresFinalFixtureAndGoalEventCountMatchingScore": true,
    "neverExposeApiKeyToBrowserOrRepository": true,
    "formationDataPath": "matches[].formationData",
    "formationUsesProviderGrid": true,
    "providerRatingPath": "playerMatchStats[].providerRatings.apiFootball",
    "providerAndJfwRatingsRemainSeparate": true,
    "playerPhotoPath": "players[].photo and playerMatchStats[].photo and matches[].formationData.teams[].startXI[].photo",
    "coachPath": "matches[].formationData.teams[].coach",
    "publicMediaUrlsRequireNoApiKey": true,
    "unsafeImageSchemesRejected": true,
    "brokenImageMustUseFallback": true
  },
  "rankingPolicy": {
    "overallSource": "seasonStats",
    "competitionSource": "competitionStats[competition]",
    "clubStatsNeverUsedForOverallRanking": true,
    "retainTransferredOutPlayers": true,
    "outOfScopePlayersRemainEligibleForAlreadyTrackedSeasonStats": true,
    "outOfScopeStatsFreezeAtTrackedExit": true,
    "doNotReclassifyHistoricalCompetitionStatsByCurrentLeague": true,
    "jfwRatingCrossPositionRanking": false
  },
  "jfwRatingPolicy": {
    "name": "JFW Rating",
    "ratingVersion": "1.0",
    "opsVersion": "ops-v1.0",
    "engine": "jfw-rating.js",
    "matchDataField": "playerMatchStats",
    "minimumInputs": ["minutes", "goals", "assists"],
    "requiredDisciplineInputs": ["yellowCards", "secondYellowRed", "straightRed", "penaltiesConceded", "ownGoals"],
    "states": ["value", "missing", "notApplicable"],
    "neverConvertMissingToZero": true,
    "zeroMayBeDerivedOnlyFromExhaustiveSource": true,
    "saveRawInputs": true,
    "saveSourcesAndConflicts": true,
    "recheckWindowHours": 72,
    "recalculateWhenInputChanges": true,
    "recentWindow": "last_5_appearances",
    "seasonAverage": "minutes_weighted",
    "crossPositionRanking": false,
    "finalRatingRange": {"min": 3.0, "max": 10.0},
    "runtimeValidityGuard": "JFWRating.isRatingValue",
    "unratedStoredValue": null,
    "unratedAppearanceCountsAsAppearance": true,
    "unratedAppearanceCountsAsRatedGame": false,
    "unratedAppearanceExcludedFromSeasonAverage": true,
    "unratedAppearanceExcludedFromRecentAverage": true,
    "averageDenominator": "minutes_of_valid_rated_games_only",
    "neverCoerceNullRatingToZero": true,
    "outOfRangeCachedRatingMustBeRejectedAndRecomputed": true,
    "allRatingConsumersMustUseValidityGuard": true
  },
  "siteViewPolicy": {
    "playerDetail": {
      "primaryStats": "seasonStats",
      "mustExpose": ["playerPhoto", "currentMembership", "previousClub", "membershipHistory", "seasonStats", "competitionStats", "clubStats", "recentPlayerMatchStats"],
      "recentMatchMustShow": ["club", "competition", "match", "ko"],
      "ratingDisplayMustUseValidityGuard": true,
      "unratedMatchMustDisplayAs": "—"
    },
    "clubDetail": {
      "mustUseCurrentTrackedMembership": true,
      "summaryStatsSource": "clubStats[currentClub]",
      "mustNotIncludeOldClubMatchesByPlayerNameOnly": true
    },
    "matchDetail": {
      "script": "match-detail.js",
      "routeParam": "match",
      "dataSources": ["matches", "topMatches", "playerMatchStats"],
      "mustExpose": ["matchSummary", "appearanceSummary", "homeAndAwayFormation", "startingXI", "playerPhotos", "coach", "coachPhoto", "substitutions", "bench", "apiFootballRating", "ratingModeSwitch", "japanesePlayerRecords", "ratingInputs", "inputStates", "jfwRating", "ratingCoverage", "ratingBreakdown", "ratingSources", "ratingConflicts"],
      "formationDisplay": "two_pitch_fotmob_inspired",
      "formationRatingModes": ["apiFootball", "jfw"],
      "individualRatingDisplay": "apiFootball_and_jfw_side_by_side",
      "showMissingExplicitly": true,
      "openFrom": ["matchLog", "featuredMatches", "searchMatches", "clubMatches", "playerMatchHistory"],
      "ratingDisplayMustUseValidityGuard": true,
      "unratedMatchMustDisplayAs": "—"
    }
  },
  "consistencyPolicy": {
    "crossCheck": ["players", "playerId", "membershipHistory", "membershipCorrections", "trackingStatus", "matches", "playerMatchStats", "seasonStats", "competitionStats", "clubStats", "clubCompetitionStats", "gaResults", "topMatches", "insights", "analysis", "rankings", "jfwRating", "matchDetail", "clubDetail", "backfillFragments", "latestSnapshot"],
    "invariants": [
      "one_logical_player_must_not_split_on_transfer",
      "historical_match_club_must_not_change_when_current_club_changes",
      "old_club_stats_must_not_appear_in_new_club_stats",
      "competition_stats_must_not_be_reclassified_by_current_league",
      "out_of_scope_transfer_must_not_delete_player_or_prior_ranked_stats",
      "out_of_scope_destination_must_not_become_a_tracked_club",
      "correction_must_not_create_fake_transfer_membership",
      "derived_totals_must_remain_traceable_to_match_records_or_explicit_aggregate_baselines",
      "missing_must_never_become_zero_without_exhaustive_source",
      "final_jfw_rating_must_be_null_or_between_3_and_10",
      "unrated_match_must_not_count_as_rated_game",
      "unrated_match_minutes_must_not_enter_rating_average_denominator",
      "null_jfw_rating_must_never_render_or_aggregate_as_zero",
      "out_of_range_cached_jfw_rating_must_not_be_reused"
    ],
    "restartFullWorkflowOnUserMismatchReport": true
  }
}
