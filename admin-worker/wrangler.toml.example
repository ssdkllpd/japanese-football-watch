name = "jfw-football-admin-ingest"
main = "index.mjs"
compatibility_date = "2026-08-31"

# Deploy this Worker separately from worker/index.mjs. It is the only
# application component permitted to write through FOOTBALL_DB.

[[r2_buckets]]
binding = "FOOTBALL_DATA"
bucket_name = "REPLACE_WITH_R2_BUCKET"

[[d1_databases]]
binding = "FOOTBALL_DB"
database_name = "REPLACE_WITH_D1_DATABASE"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

# Set this as a Worker secret; never commit the value.
# wrangler secret put ADMIN_INGEST_TOKEN
